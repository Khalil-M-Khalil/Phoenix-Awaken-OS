#!/usr/bin/env python3
"""Inspect a Phoenix Aether Evidence Relay bundle locally."""
from __future__ import annotations

import argparse
import json
from pathlib import Path

from capsule.relay import EvidenceRelay


def main() -> int:
    parser = argparse.ArgumentParser(description="Inspect a local Phoenix Aether Evidence Relay")
    parser.add_argument("bundle", type=Path)
    args = parser.parse_args()
    result = EvidenceRelay.inspect(args.bundle)
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0 if result["status"] == "verified" else 2


if __name__ == "__main__":
    raise SystemExit(main())
