#!/usr/bin/env bash
set -euo pipefail

# Phoenix Awaken OS style reminder: database updates are explicit, visible,
# and separate from local evidence scanning.
if ! command -v grype >/dev/null 2>&1; then
  echo "Grype is not installed in this environment." >&2
  exit 1
fi

echo "Updating the local Grype vulnerability database. This requires network access."
exec env GRYPE_DB_AUTO_UPDATE=true grype db update "$@"

